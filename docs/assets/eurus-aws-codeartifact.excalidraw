      "link": null,
      "locked": false,
      "text": "Internal package group origin control\n(applies to both \"staging\" and\n\"approved\" repositories)\n\n/pypi//myorg~\n/npm/myorg/*\n\npublish=BLOCK\nexternal_upstream=ALLOW\ninternal_upstream=BLOCK",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internal package group origin control\n(applies to both \"staging\" and\n\"approved\" repositories)\n\n/pypi//myorg~\n/npm/myorg/*\n\npublish=BLOCK\nexternal_upstream=ALLOW\ninternal_upstream=BLOCK",
      "autoResize": true,
      "lineHeight": 1.25
    },
